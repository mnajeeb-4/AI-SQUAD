# ============================================
# AI Squad - Git Ignore File
# ============================================

# ---------- Environment Variables (CRITICAL) ----------

.env
.env.local
.env.*.local
*.env

# ---------- Python (Backend) ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
env/
ENV/
.venv/
env.bak/
venv.bak/

# Python Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# ---------- Node.js (Frontend) ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
package-lock.json.bak

# Next.js (if added later)
.next/
out/
.vercel

# ---------- IDE & Editor ----------
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---------- Data & Large Files ----------
# Don't commit large PDF files (they're already processed into Supabase)
*.pdf
!requirements.txt

# Embedding model cache (large, re-downloadable)
.cache/
sentence_transformers_cache/
huggingface/

# ---------- Logs ----------
*.log
logs/

# ---------- Test Outputs ----------
tests/output/
tests/temp/

# ---------- Supabase ----------
.supabase/

# ---------- Jupyter Notebooks ----------
.ipynb_checkpoints/